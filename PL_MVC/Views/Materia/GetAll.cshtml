@model ML.Materia
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container">
    <div class="row">
        <div class="col-md-6">
            @Html.ActionLink("+", "Formulario", "Materia", new { IdMateria = 0 }, new { @class = "btn btn-success" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            @if (Model.Materias != null)
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th> Status </th>
                            <th> Editar </th>
                            <th> IdMateria </th>
                            <th> Nombre </th>
                            <th> Creditos </th>
                            <th> Descripcion </th>
                            <th> Costo </th>
                            <th> Semestre </th>
                            <th> Imagen </th>
                            <th> Eliminar </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ML.Materia materia in Model.Materias)
                        {


                            <tr>
                                <td>
                                    @if (materia.Status)
                                    {
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckChecked" checked onchange="CambiarStatus(@materia.IdMateria, this)">
                                            <label class="form-check-label" for="switchCheckChecked">Checked switch checkbox input</label>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault" onchange="CambiarStatus(@materia.IdMateria, this)">
                                            <label class="form-check-label" for="switchCheckDefault">Default switch checkbox input</label>
                                        </div>
                                    }
                                </td>
                                <td>

                                    <a href="@Url.Action("Formulario", "Materia", new {IdMateria = materia.IdMateria})"> Prueba</a>

                                </td>
                                <td>@materia.IdMateria</td>
                                <td>@materia.Nombre</td>
                                <td>@materia.Creditos</td>
                                <td>@materia.Descripcion</td>
                                <td>@materia.Costo</td>
                                <td>@materia.Semestre.Nombre</td>
                                <td>
                                    @if (materia.Imagen == null)
                                    {
                                        <img id="imgMateria" height="200px" src="~/Img/Default.png" width="200px" />
                                    }
                                    else
                                    {
                                        <img id="imgMateria" height="200px" src="data:image/*;base64,@Convert.ToBase64String(materia.Imagen)" width="200px" />

                                    }
                                </td>
                                <td>
                                    <a href="@Url.Action("Delete", "Materia", new {IdMateria = materia.IdMateria})">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    A simple danger alert—check it out!
                </div>
            }

        </div>
    </div>

</div>


<script>
    var urlAJAX = '@Url.Action("ChangeStatus")';
</script>

<script src="~/Scripts/Materia/Status.js"></script>