@model ML.Materia
@{
    ViewBag.Title = "Formulario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container">
    <div class="row">
        <div class="col-12">
            <h2>Materia</h2>
        </div>
    </div>

    <button class="btn btn-info" id="btnPrueba" > Dar Click </button>


    <div class="row">
        <div class="col-12">
            <h5>Ingrese los datos de la materia:</h5>
            <hr />
        </div>
    </div>
    @using (Html.BeginForm("Formulario", "Materia", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="row">
            <div class="col-6">
                <div class="row">
                    <div class="col-6">
                        @Html.LabelFor(model => model.IdMateria, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.IdMateria, new { @class = "form-control" })
                    </div>
                    <div class="col-6">
                        @Html.LabelFor(model => model.Nombre, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", @id="txtNombre", @onkeypress="return ValidarSoloLetras(event)" })
                        <label id="lblErrorNombre"></label>
                    </div>
                </div>

                <div class="row mt-3">

                    <div class="col-6">
                        @Html.LabelFor(model => model.Creditos, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Creditos, new { @class = "form-control" })
                    </div>
                    <div class="col-6">
                        @Html.LabelFor(model => model.Descripcion, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Descripcion, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-6">
                        @Html.LabelFor(model => model.Costo, new { @class = "form-label" })
                        @Html.TextBoxFor(model => model.Costo, new { @class = "form-control" })
                    </div>
                    <div class="col-6">
                        @Html.LabelFor(model => model.Semestre.IdSemestre, new { @class = "form-label" })
                        @*@Html.TextBoxFor(model => model.Semestre.IdSemestre, new { @class = "form-control" })*@

                        @*@Html.DropDownListFor(model => model.Semestre.IdSemestre, new SelectList(Model.Semestre.Semestres, "IdSemestre", "Nombre"), "Selecciona una opcion", new { @class = "form-control" })*@

                    </div>
                </div>


                @Html.HiddenFor(model => model.Imagen)
                @*@Html.HiddenFor(model => model.Action)*@




                <div class="row mt-3">
                    <div class="col-2">
                        <input type="submit" name="Action" value="Guardar" class="btn btn-success" />
                    </div>
                    <div class="col-2">
                        @Html.ActionLink("Regresar", "GetAll", "Materia", new { @class = "btn btn-danger" })
                    </div>

                </div>
            </div>

            <div class="col-6">
                <div class="row">
                    <div class="col-12">
                        <img id="imgMateria" height="100px" src="~/Img/Default.png" width="100px" />

                        @Html.TextAreaFor(model => model.MateriaImagen.Descripcion, new { @class = "form-control" })

                    </div>

                </div>
                <div class="row">
                    <input type="file" name="imgMateriaInput" onchange="PrevisualizarImagen(event)" />

                    <input type="submit" value="Cargar" name="Action" class="btn btn-info" />
                </div>

                <div class="row">
                    @if (Model.MateriaImagen != null)
                    {
                        if (Model.MateriaImagen.MateriasImagenes.Count > 0)
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th> IdMateriaImagen </th>
                                        <th> Descripción </th>
                                        <th> Imagen </th>
                                        <th> Eliminar </th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (ML.MateriaImagen materiaImagen in Model.MateriaImagen.MateriasImagenes)
                                    {
                                        <tr>

                                            <td>@materiaImagen.IdMateriaImagen</td>
                                            <td>@materiaImagen.Descripcion</td>
                                            <td>
                                                @if (materiaImagen.Imagen == null)
                                                {
                                                    <img id="imgMateria" height="100px" src="~/Img/Default.png" width="100px" />
                                                }
                                                else
                                                {
                                                    <img id="imgMateria" height="100px" src="data:image/*;base64,@Convert.ToBase64String(materiaImagen.Imagen)" width="100px" />

                                                }

                                            </td>
                                            <td>
                                                <a href="@Url.Action("DeleteImagen", "Materia", new {IdMateriaImagen = @materiaImagen.IdMateriaImagen, Descripcion = materiaImagen.Descripcion, IdMateria = Model.IdMateria})">
                                                    <i class="bi bi-trash-fill">prueba</i>
                                                </a>

                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }



                </div>
            </div>

        </div>

    }



</div>




@*@Scripts.Render("~/bundles/jquery")*@
<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/Materia/Validaciones/ValidacionesRegex.js"></script>

<script type="text/javascript">

    console.log($('div'))

